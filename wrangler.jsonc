// Cloudflare Workers 配置
// 文档: https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "name": "minigames",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  // 静态页面目录：public/ 下的文件会作为静态资源托管，
  // 未命中 /api/* 的请求都由静态资源应答
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // 可选：云端排行榜存储（KV）。
  // 1. 运行: npx wrangler kv namespace create SCORES
  // 2. 把命令输出的 id 填到下面并取消注释，重新部署即可。
  // 不配置也不影响游戏运行（排行榜自动退回浏览器本地存储）。
  //
  // ,"kv_namespaces": [
  //   { "binding": "SCORES", "id": "在这里填入你的 KV namespace id" }
  // ]
}
